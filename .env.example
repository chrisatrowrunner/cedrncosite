# API credentials (server-side only — never exposed to the browser).

# --- SerpAPI: Google Flights search (flights) ---
# Get a key at https://serpapi.com (free tier available).
SERPAPI_KEY=your_serpapi_key_here

# --- Duffel: hotels (Stays) + city/airport autocomplete (Places) ---
# Create a token at https://app.duffel.com -> Developers -> Access tokens.
# Sandbox vs live is chosen by the token itself (same host):
#   duffel_test_...  -> sandbox / test data (free)
#   duffel_live_...  -> live inventory (requires an activated Duffel account)
DUFFEL_ACCESS_TOKEN=duffel_test_your_token_here

# Optional - pin the Duffel API version (default: v2)
# DUFFEL_VERSION=v2
